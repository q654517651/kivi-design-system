{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "mdx"],
    "baseUrl": ".",
    "paths": {
      "@kivi": ["src/kivi"],
      "@kivi/*": ["src/kivi/*"],
      "@shell": ["src/shell"],
      "@shell/*": ["src/shell/*"]
    }
  },
  "include": ["src"]
}
